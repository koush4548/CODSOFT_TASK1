# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud Storage Engine Configuration (Supports 'local', 's3', or 'minio')
STORAGE_DRIVER="local"

# AWS S3 / MinIO Configuration (Optional if STORAGE_DRIVER=s3 or minio)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="my-cloud-storage-bucket"
AWS_S3_ENDPOINT="" # Optional custom endpoint for MinIO or LocalStack (e.g., http://127.0.0.1:9000)
AWS_S3_FORCE_PATH_STYLE="false" # Set true for MinIO

# Presigned URL secret and signature salt (for local/hybrid presigned signatures)
PRESIGNED_URL_SECRET="cloudvault-super-secure-secret-key-2026"

# Storage Quota and Max Upload Limits (in bytes, 100GB quota, up to 10GB per file)
MAX_FILE_SIZE_BYTES=10737418240
STORAGE_QUOTA_BYTES=107374182400
